# IntrovertSOC backend configuration
# Copy to .env and adjust. THERE ARE NO API KEYS HERE - IntrovertSOC never uses any.
# The only LLM it talks to is your local llamafile server.

# --- Local llamafile / OpenAI-compatible endpoint -----------------------------------------
# Option A: host + port (recommended)
LLAMAFILE_HOST=127.0.0.1
LLAMAFILE_PORT=8080
# Option B: full base URL (overrides host/port when set), e.g. http://127.0.0.1:8080
#LLAMAFILE_BASE_URL=http://127.0.0.1:8080

# Cosmetic model name sent in the "model" field (the real weights are whatever GGUF
# you started llamafile with). Shown on the Model Settings page.
LLAMAFILE_MODEL=local-model

# Optional: absolute path to the GGUF file you want llamafile to serve. Purely informational
# for the UI (it generates the launch command for you); llamafile loads it at start.
#LLAMAFILE_MODEL_PATH=

# Timeouts (seconds). Local CPU/GPU inference is slower than cloud APIs - be generous.
LLAMAFILE_CONNECT_TIMEOUT=5
LLAMAFILE_TIMEOUT=180

# Never shown in the UI, never stored per-provider. Only sent if a server insists on a key.
LLAMAFILE_API_KEY=local

# --- Django -------------------------------------------------------------------------------
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
#DJANGO_SECRET_KEY=
#DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
